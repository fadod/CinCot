<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK projection for Windows.Media.Ocr (on-device text recognition). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Sikirincot</AssemblyName>
    <RootNamespace>Sikirincot</RootNamespace>
    <Version>0.2.0</Version>
    <Product>Sikirincot</Product>
    <Description>Instant screenshot and redaction tool for Windows</Description>
    <!-- Physical-pixel coordinates everywhere; the overlay spans monitors with mixed scaling. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sikirincot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

</Project>
